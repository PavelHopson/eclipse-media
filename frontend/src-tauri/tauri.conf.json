{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eclipse Media",
  "version": "1.4.0",
  "identifier": "forge.eclipse.media",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eclipse Media",
        "width": 1440,
        "height": 900,
        "minWidth": 920,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/eclipse-media-core"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Eclipse Forge. Eclipse Media.",
    "category": "Video",
    "publisher": "Eclipse Forge",
    "shortDescription": "Local-first media workspace",
    "longDescription": "Eclipse Media downloads and processes authorized public media in a private local desktop workspace.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "compression": "lzma",
        "displayLanguageSelector": true,
        "languages": ["Russian", "English"],
        "installMode": "currentUser",
        "startMenuFolder": "Eclipse Forge",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/uninstaller-header.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
